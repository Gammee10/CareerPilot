# CareerPilot Compose configuration (non-secret values only).
# Copy to `.env` for local dev:  Copy-Item .env.example .env
#
# SECRET VALUES NEVER GO HERE (ADR-056). Secrets live only in file-mounted
# Compose secrets sourced from secrets/local (dev) or OCI Vault (prod).

# Directory containing the secret files referenced by compose.yaml.
CAREERPILOT_SECRET_DIR=./secrets/local

# PostgreSQL identifiers (not credentials).
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot

# Runtime configuration (not secrets).
LOG_LEVEL=info

# Public domain for Caddy automatic HTTPS (production VM only; empty locally).
DOMAIN=
