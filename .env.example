# CareerPilot Compose configuration (non-secret values only).
# Copy to `.env` for local dev:  Copy-Item .env.example .env
#
# SECRET VALUES NEVER GO HERE (ADR-056). Secrets live only in file-mounted
# Compose secrets sourced from secrets/local (dev, via scripts/dev-secrets.*)
# or OCI Vault (prod, via scripts/fetch-vault-secrets.sh into secrets/prod/
# and CAREERPILOT_SECRET_DIR pointing there).
#
# Every non-secret variable the Compose stack and backend consume is listed
# below with its default. Anything not set here falls back to the default
# shown (see apps/backend/src/config.ts, the single place defaults live).

# Directory containing the secret files referenced by compose.yaml.
CAREERPILOT_SECRET_DIR=./secrets/local

# PostgreSQL identifiers (not credentials; the password itself is the
# postgres_password file-mounted secret, optionally overridden for tooling
# via PGPASSWORD_FILE).
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot
# PGHOST=postgres
# PGPORT=5432
# PGDATABASE=${POSTGRES_DB:-careerpilot}
# PGUSER=${POSTGRES_USER:-careerpilot}
# PGBOSS_SCHEMA=pgboss

# Backend / worker runtime.
# PORT=8080
# WORKER_HEALTH_PORT=8081
# NODE_ENV=production
# LOG_LEVEL=info
LOG_LEVEL=info
# APP_PUBLIC_URL=http://localhost:8080
# AI_INTERNAL_URL=http://ai:8000
# OBJECT_STORE_DRIVER=inmemory
# MIGRATIONS_DIR=./db/migrations

# Identity policy (tests override via env; never in production).
# SIGNIN_LINK_TTL_MINUTES=15

# Transactional email sender identity (the API key is the resend_api_key
# file-mounted secret, optionally overridden via RESEND_API_KEY_FILE).
# EMAIL_FROM=CareerPilot <no-reply@localhost>
# RESEND_API_KEY_FILE=/run/secrets/resend_api_key

# Internal AI capability caller token (file-mounted secret shared by backend,
# worker, and ai; optionally overridden for tooling).
# AI_INTERNAL_TOKEN_FILE=/run/secrets/ai_internal_token

# Public domain for Caddy automatic HTTPS (production VM only; empty locally).
DOMAIN=

# --- Operations (VM cron / backup scripts; see ops/*.sh headers) ---
# BACKUP_DIR=./backups
# BACKUP_ENCRYPTION_KEY_FILE=/path/to/backup.key
# UPLOAD_CMD=xargs -I{} oci os object put --bucket-name careerpilot-backup --file {}
# DOWNLOAD_CMD=xargs -I{} oci os object get --bucket-name careerpilot-backup --name {} --file -
# RETENTION_DAYS=90
# ALERT_RECIPIENT=ops@example.invalid
# ALERT_RECIPIENT is required for real (non-DRY_RUN) health-check alerts.
# DISK_THRESHOLD_PCT=80
# COMPOSE_PROJECT=careerpilot
# DRY_RUN=1
