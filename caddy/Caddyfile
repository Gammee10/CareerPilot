# CareerPilot public entry point — LOCAL DEVELOPMENT (ADR-055).
#
# Listens on plain HTTP :80 (the dev override binds it to 127.0.0.1:8080).
# Only approved endpoints are routed: /api/* -> backend, rest -> frontend.
#
# Production uses caddy/Caddyfile.production via compose.prod.yaml.

:80 {
	encode zstd gzip

	# Transport hardening headers at the edge (H10). Tokens ride in URLs on
	# the passwordless flows, so the Referrer-Policy never leaks full URLs
	# cross-origin; framing is denied (the app has no embed use case).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# H9 minimization: single-use link tokens arrive as ?token= query strings
	# on these pages. Skip access logging for them entirely — a default access
	# log would otherwise capture the full URI including the bearer secret
	# (the largest ADR-015 hole). API bearer material (resume grants) travels
	# in the X-Grant-Token header, which access logs never record.
	handle /signin* {
		log_skip
		reverse_proxy frontend:3000
	}
	handle /closure* {
		log_skip
		reverse_proxy frontend:3000
	}
	handle /activate* {
		log_skip
		reverse_proxy frontend:3000
	}

	# Authoritative application API. `handle` (NOT `handle_path`) preserves
	# the /api prefix: backend routes are defined with it, so stripping
	# would 404 every browser API call (the prefix is part of the route).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Everything else: dashboard frontend.
	handle {
		reverse_proxy frontend:3000
	}
}
