# CareerPilot public entry point — LOCAL DEVELOPMENT (ADR-055).
#
# Listens on plain HTTP :80 (the dev override binds it to 127.0.0.1:8080).
# Only approved endpoints are routed: /api/* -> backend, rest -> frontend.
#
# Production uses caddy/Caddyfile.production via compose.prod.yaml.

:80 {
	encode zstd gzip

	# Transport hardening headers at the edge (H10). Tokens ride in URLs on
	# the passwordless flows, so the Referrer-Policy never leaks full URLs
	# cross-origin; framing is denied (the app has no embed use case).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Authoritative application API (prefix stripped before proxying).
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	# Everything else: dashboard frontend.
	handle {
		reverse_proxy frontend:3000
	}
}
